<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- TexSharp is a submodule in lib. A program that uses several of these libraries sets TxtgLibRoot, or TexSharpProject, so they share one. -->
    <TxtgLibRoot Condition="'$(TxtgLibRoot)' == ''">$(MSBuildThisFileDirectory)..\..\lib</TxtgLibRoot>
    <TexSharpProject Condition="'$(TexSharpProject)' == ''">$(TxtgLibRoot)\TexSharp\src\TexSharp\TexSharp.csproj</TexSharpProject>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>TxtgSharp</RootNamespace>
    <AssemblyName>TxtgSharp</AssemblyName>
    <Version>0.4.0</Version>
    <Description>Reader and writer for the Tears of the Kingdom TexToGo (.txtg) texture container.</Description>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(TexSharpProject)" />
  </ItemGroup>

</Project>
